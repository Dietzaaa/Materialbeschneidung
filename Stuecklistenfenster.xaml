<Window x:Class="Materialbeschneidung.Stuecklistenfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stückliste"
        Height="530"
        Width="960"
        Background="#f5f5f7"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Überschrift -->
        <TextBlock Grid.Row="0"
                   Text="Stückliste"
                   FontSize="40"
                   FontWeight="DemiBold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   Margin="0 10 0 25"/>

        <!-- DataGrid in moderner Karte -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="40 0 40 0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.25"/>
            </Border.Effect>

            <DataGrid x:Name="KundenDataGrid"
                      AutoGenerateColumns="True"
                      HeadersVisibility="All"
                      GridLinesVisibility="None"
                      RowHeight="32"
                      ColumnHeaderHeight="40"
                      BorderThickness="0"
                      AlternatingRowBackground="#f2f2f2"
                      d:ItemsSource="{d:SampleData ItemCount=10}"/>
        </Border>

        <!-- Button-Zeile unten rechts -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 20 40 10">

            <Button Content="Zurück"
                    Width="100"
                    Height="36"
                    Background="#e0e0e0"
                    Foreground="#333"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="6"
                    FontWeight="SemiBold"
                    Margin="0 0 10 0"
                    Click="Button_Click_Zurueck"/>

            <Button Content="Berechnen"
                    Width="130"
                    Height="36"
                    Background="#5331AF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="6"
                    FontWeight="SemiBold"
                    Click="Button_Click_Berechnen">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.3"/>
                </Button.Effect>
            </Button>

        </StackPanel>

    </Grid>
</Window>
