<Window x:Class="Materialbeschneidung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auftragssuche"
        Height="530"
        Width="960"
        Background="#f5f5f7"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Eingabe-Karte -->
        <Border Background="White"
                CornerRadius="12"
                Padding="25"
                Margin="10"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Auftragssuche"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#333"
                           Margin="0 0 0 20"/>

                <TextBlock Text="Geben Sie Ihre Auftragsnummer ein:"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox x:Name="txtBox_auftragsnummer"
                         Text="K01-01-000001"
                         Height="32"
                         FontSize="14"
                         Margin="0 0 30 0"
                         Padding="6"
                         Background="#fafafa"/>

                <StackPanel Orientation="Horizontal" Margin="0 15 0 0">

                    <Button Content="Suchen"
                            Width="110"
                            Height="34"
                            Background="#5331AF"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="Button_Click_Suchen">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>

                    <Button Content="weitere hinzufügen"
                            Margin="10 0 0 0"
                            Width="160"
                            Height="34"
                            Background="#e0e0e0"
                            Foreground="#333"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="Button_Click_Hinzufuegen"/>
                </StackPanel>

                <Label x:Name="label_fehlermeldung"
                           Content=""
                           Foreground="Red"
                           FontWeight="SemiBold"
                           Margin="0 10 0 0"/>

            </StackPanel>
        </Border>

        <!-- Rechte Liste -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="20 10 10 10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Gespeicherte Auftragsnummern"
                           FontSize="20"
                           FontWeight="DemiBold"
                           Foreground="#333"
                           Margin="0 0 0 15"/>

                <ListBox x:Name="lstBox_Auftragsnummer"
                         Background="#fafafa"
                         FontSize="14"
                         Padding="6"
                         BorderThickness="0"
                         d:ItemsSource="{d:SampleData ItemCount=5}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
